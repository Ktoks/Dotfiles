#!/usr/bin/env bash
alias winhome='cd /mnt/c/Users/$(whoami)'
alias aliases='alias | grep -E "config|ls|hx|src"'
alias config='git --git-dir=$HOME/.cfg/ --work-tree=$HOME'
alias src="source ~/.bashrc"

if ls --color >/dev/null 2>&1; then
  alias ls='ls --color=auto -A'
else # ls alias for BSD
  alias ls='ls -G -A'
fi
alias sl="ls"
alias ll="ls -ho"
alias lls="ll -tr"
alias lsl="lls "
alias lsls="lls "
[ ! "$(command -v  hx)" ] && alias hx="helix "
[ "$(command -v  go)" ] && alias gobld="GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -trimpath -ldflags \"-w -s\""
[ "$(command -v  cargo)" ] && alias cargo-optimize="cargo install --config 'build.rustflags=[\"-C\", \"target-cpu=native\", \"-C\", \"lto=thin\", \"-C\", \"codegen-units=1\", \"-C\", \"strip=symbols\"]'"
