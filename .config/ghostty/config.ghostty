# --- Theme & Colors ---
# Ghostty natively supports OS-level dark/light mode switching
theme = Gruvbox Dark Hard

# Overriding the background to pure black
background = 000000

# --- Window & Tabs ---
# Removes standard OS titlebars.
# Note: Ghostty natively hides the tab bar when only one tab is open.
window-decoration = false
scrollbar = never

# --- Mouse Behavior ---
# Automatically copies selections to the clipboard upon mouse release
copy-on-select = true

# --- Keybindings ---

# --- Clipboard ---
keybind = ctrl+shift+v=paste_from_clipboard

# --- Window & Tab Management ---
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+f=toggle_fullscreen

# --- Tab Navigation ---
# keybind = ctrl+tab=goto_tab:next
# keybind = ctrl+shift+tab=goto_tab:prev

# --- Pane (Split) Creation ---
keybind = ctrl+shift+alt+%=new_split:right
keybind = ctrl+shift+alt+"=new_split:down

# --- Pane Navigation ---
keybind = ctrl+shift+up=goto_split:top
keybind = ctrl+shift+down=goto_split:bottom
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right

# --- Pane Resizing ---
keybind = ctrl+shift+alt+up=resize_split:up,20
keybind = ctrl+shift+alt+down=resize_split:down,20
keybind = ctrl+shift+alt+left=resize_split:left,20
keybind = ctrl+shift+alt+right=resize_split:right,20
